---
import { SITE, categories } from "../lib/constants";
import WhatsAppCTA from "./WhatsAppCTA.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!-- Enlaces sociales centralizados para todas las páginas públicas. -->
<footer class="site-footer"><div class="wrap"><nav class="footer-categories" aria-label="Categorías de trabajos y lecturas"><strong>Explorá</strong><ul>{categories.map((category) => <li><a href={`${base}${category.href}`} data-cta-location="footer_categories" data-category={category.key}>{category.label}</a></li>)}</ul></nav><div class="footer-inner"><p>© 2026 Cristal Sagrado. Todos los derechos reservados.</p><ul class="social-links"><li><WhatsAppCTA label="WhatsApp" ctaLocation="footer" /></li><li><a href={SITE.instagram}>Instagram</a></li><li><a href={SITE.tiktok}>TikTok</a></li></ul></div></div></footer>
