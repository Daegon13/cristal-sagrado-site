---
import WhatsAppCTA from "./WhatsAppCTA.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<header class="site-header">
  <div class="site-header__inner wrap">
    <a class="brand" href={base} aria-label="Cristal Sagrado, inicio">Cristal Sagrado</a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href={`${base}#servicios`}>Trabajos</a><a href={`${base}tarot/`}>Tarot</a><a href={`${base}como-trabajamos/`}>Cómo funciona</a><a href={`${base}faq/`}>FAQ</a>
      <WhatsAppCTA label="Consultar" className="button button--header" ctaLocation="header" />
    </nav>
    <WhatsAppCTA label="Consultar" className="button button--header mobile-consult" ctaLocation="header" />
  </div>
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href={`${base}#servicios`}>Trabajos</a><a href={`${base}tarot/`}>Tarot</a><a href={`${base}como-trabajamos/`}>Cómo funciona</a><a href={`${base}faq/`}>FAQ</a>
  </nav>
</header>
