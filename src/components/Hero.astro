---
interface Props { title: string; subtitle?: string; action?: string; href?: string; ctaLocation?: string; ritualImage?: boolean; }
const { title, subtitle, action, href = "#contacto", ctaLocation = "hero", ritualImage = false } = Astro.props;
import WhatsAppCTA from "./WhatsAppCTA.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<section class:list={["hero", { "hero--ritual": ritualImage }]} style={ritualImage ? `--hero-mobile:url("${base}hero-ritual-mobile.webp");--hero-desktop:url("${base}hero-ritual-desktop.webp")` : `--hero-image:url("${base}images/moon-poster.webp")`}><div class="wrap hero__content"><span class="eyebrow">Cristal Sagrado · Uruguay</span><h1>{title}</h1>{subtitle && <p>{subtitle}</p>}{action && <div class="hero__actions">{href === "#contacto" || href.endsWith("#formulario") ? <WhatsAppCTA label={action} className="button button--primary" ctaLocation={ctaLocation} /> : <a data-cta-location={ctaLocation} class="button button--primary" href={href}>{action}</a>}{ctaLocation === "hero" && <a class="text-link" data-cta-location="hero" href={`${base}#servicios`}>Explorar trabajos y lecturas <span aria-hidden="true">↗</span></a>}</div>}</div></section>
