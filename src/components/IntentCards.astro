---
import WhatsAppCTA from "./WhatsAppCTA.astro";
const intents = [
  ["Amor y pareja", "Cuando un vínculo te genera dudas o necesitás mirar la situación con calma."],
  ["Limpieza y protección", "Para conversar sobre cargas, bloqueos o una búsqueda de resguardo."],
  ["Tarot", "Una lectura para ordenar preguntas y explorar posibilidades."],
  ["Trabajo, dinero y caminos", "Si buscás orientación sobre decisiones, movimiento o prosperidad."],
  ["No sé qué necesito", "Contame lo que pasa y vemos juntas por dónde empezar."]
];
---
<section class="section intentions" aria-labelledby="intent-title"><div class="wrap">
  <div class="section-intro"><span class="eyebrow">Empezá por vos</span><h2 id="intent-title">¿Qué estás viviendo?</h2><p>No necesitás conocer el nombre de un ritual. Elegí lo que más se acerca a tu situación.</p></div>
  <ul class="intent-grid">{intents.map(([title, description], index) => <li class="intent-card"><span class="intent-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><div><h3>{title}</h3><p>{description}</p><WhatsAppCTA label="Contame tu caso ↗" ctaLocation="intent" intent={title} ariaLabel={`Contame tu caso sobre ${title}`} /></div></li>)}</ul>
</div></section>
