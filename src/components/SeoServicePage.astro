---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppCTA from "./WhatsAppCTA.astro";
import snapshot from "../data/generated/services.public.json";
import { relatedServices } from "../lib/seo-services.js";
import { canonical } from "../lib/seo";
import { categories } from "../lib/constants";
const { entry } = Astro.props;
const { service, path } = entry;
const category = categories.find((item) => item.key === service.category);
const related = relatedServices(snapshot, entry);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const local = (url) => `${base}${url.slice(1)}`;
const cleanName = service.name.replace(/[\p{Extended_Pictographic}\uFE0F\u200D]/gu, "").trim();
const crumbs = [
  { name: "Inicio", item: canonical("/") },
  { name: category.label, item: canonical(`/${category.href}`) },
  { name: cleanName, item: canonical(path) }
];
const schema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: crumbs.map((crumb, i) => ({ "@type": "ListItem", position: i + 1, name: crumb.name, item: crumb.item })) };
---
<BaseLayout title={entry.title} description={service.descriptionShort} path={path} schema={schema}>
  <main class="wrap seo-page">
    <nav aria-label="Ruta de navegación" class="seo-breadcrumbs"><ol><li><a href={local("/")}>Inicio</a></li><li><a href={local(`/${category.href}`)}>{category.label}</a></li><li aria-current="page">{cleanName}</li></ol></nav>
    <header class="seo-page__intro"><span class="eyebrow">{category.label}</span><h1>{cleanName}</h1><p class="seo-lead">{service.descriptionShort}</p><WhatsAppCTA label="Consultar este trabajo por WhatsApp" className="serv-cta" ctaLocation="seo_service_page" serviceName={service.name} serviceSlug={service.slug} category={service.category} direct /></header>
    <section aria-labelledby="que-es"><h2 id="que-es">Sobre este trabajo</h2><p class="seo-service-copy">{service.descriptionLong}</p></section>
    {service.idealFor.length > 0 && <section aria-labelledby="cuando"><h2 id="cuando">Ideal para</h2><ul>{service.idealFor.map((item) => <li>{item}</li>)}</ul></section>}
    {service.benefits.length > 0 && <section aria-labelledby="beneficios"><h2 id="beneficios">Características y finalidades simbólicas</h2><ul>{service.benefits.map((item) => <li>{item}</li>)}</ul></section>}
    {service.intent.length > 0 && <section aria-labelledby="intenciones"><h2 id="intenciones">Intenciones</h2><ul>{service.intent.map((item) => <li>{item}</li>)}</ul></section>}
    {service.notFor.length > 0 && <section aria-labelledby="limites"><h2 id="limites">No orientado a</h2><ul>{service.notFor.map((item) => <li>{item}</li>)}</ul></section>}
    <section aria-labelledby="datos"><h2 id="datos">Datos publicados del servicio</h2>{service.price !== null && <dl><dt>Precio publicado</dt><dd>${service.price}</dd></dl>}<p>Confirmá disponibilidad, precio vigente, duración y condiciones antes de avanzar. Los detalles del proceso se conversan según el trabajo.</p></section>
    <section aria-labelledby="consulta"><h2 id="consulta">¿Cómo funciona la consulta?</h2><p>Si ya elegiste este trabajo, el enlace abre WhatsApp con su nombre; podés explicar tu situación allí. Si necesitás orientación, contá brevemente qué estás viviendo y conversamos sobre las opciones antes de avanzar.</p><WhatsAppCTA label="Necesito orientación" className="text-link" ctaLocation="seo_service_guided" category={service.category} /></section>
    <section aria-labelledby="preguntas"><h2 id="preguntas">Preguntas frecuentes</h2><h3>¿Tengo que elegir este trabajo antes de escribir?</h3><p>No. Podés contarme qué está pasando y te oriento sobre las opciones del catálogo.</p><h3>¿Se garantiza un resultado?</h3><p>No se prometen resultados ni cambios en la voluntad de otras personas. Primero conversamos sobre el alcance de la propuesta.</p></section>
    <section aria-labelledby="relacionados"><h2 id="relacionados">Otros trabajos que podés explorar</h2><ul class="seo-related">{related.map((item) => <li><a href={local(item.path)}>{item.service.name}</a></li>)}</ul><p><a href={local(`/${category.href}`)}>Ver todos los trabajos de {category.label}</a></p></section>
    <section class="seo-final"><h2>Consultar por {cleanName}</h2><p>Podés contar tu situación dentro de WhatsApp y confirmar los detalles antes de decidir.</p><WhatsAppCTA label="Consultar este trabajo" className="serv-cta" ctaLocation="seo_service_page" serviceName={service.name} serviceSlug={service.slug} category={service.category} direct /></section>
  </main>
</BaseLayout>
