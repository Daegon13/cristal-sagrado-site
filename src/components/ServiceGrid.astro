---
import { categories } from "../lib/constants";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!-- Grilla estática de rutas de servicio, independiente de la consulta dinámica Firestore. -->
<section class="section works" id="servicios"><div class="wrap"><div class="section-intro"><span class="eyebrow">Explorá los caminos</span><h2>Trabajos y lecturas</h2><p>Conocé las opciones disponibles. Si no sabés cuál corresponde, primero contame tu caso.</p></div><div class="service-grid">{categories.map((category, index) => <article class="service-card category-card"><span class="service-card__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><div class="service-card__body"><h3><a href={`${base}${category.href}`} data-cta-location="category_grid" data-category={category.key}>{category.label}</a></h3><p>{category.description}</p><a class="service-card__cta" href={`${base}${category.href}`} data-cta-location="category_grid" data-category={category.key}>{category.cta} <span aria-hidden="true">↗</span></a></div></article>)}</div></div></section>
