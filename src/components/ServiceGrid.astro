---
import { categories } from "../lib/constants";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!-- Grilla estática de rutas de servicio, independiente de la consulta dinámica Firestore. -->
<section class="section" id="servicios"><div class="wrap"><h2>Nuestros Servicios</h2><div class="service-grid">{categories.map((category) => <a class="service-card surface" href={`${base}${category.href}`}><h3>{category.label}</h3><p>{category.description}</p></a>)}</div></div></section>
