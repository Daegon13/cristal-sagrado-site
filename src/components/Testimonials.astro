---
import { testimonials, SITE } from "../lib/constants";
import WhatsAppCTA from "./WhatsAppCTA.astro";
---
<!-- Testimonios preservados y servidos en HTML estático. -->
<section class="section testimonials" id="testimonios"><div class="wrap"><div class="section-intro"><span class="eyebrow">Voces reales</span><h2>Lo que comparten</h2><a class="text-link" href={SITE.instagram} rel="noopener noreferrer">Conocé Cristal Sagrado en Instagram ↗</a></div><div class="testimonial-grid">{testimonials.map((item) => <blockquote><p>“{item.quote}”</p><footer>— {item.attribution}</footer></blockquote>)}</div><div class="section-action"><WhatsAppCTA label="Contame mi caso" className="button button--primary" ctaLocation="testimonials" /></div></div></section>
