---
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!-- Fondo fijo decorativo fuera del flujo para que el video no cambie la altura de la página. -->
<div class="video-background" aria-hidden="true" style={`--poster-url:url("${base}images/video-poster.svg")`}><video autoplay muted loop playsinline preload="none" poster={`${base}images/video-poster.svg`} class="js-bg-video" data-src={`${base}images/Eclipse_small.mp4`}></video></div>
<script>
// El video se carga en idle solo en pantallas grandes y sin preferencias de ahorro.
const mediaMatch = (query: string) => typeof window.matchMedia === "function" && window.matchMedia(query).matches;
const network = navigator as Navigator & { connection?: { saveData?: boolean }; mozConnection?: { saveData?: boolean }; webkitConnection?: { saveData?: boolean } };
const skip = mediaMatch("(prefers-reduced-motion: reduce)") || mediaMatch("(prefers-reduced-data: reduce)") || mediaMatch("(max-width: 959px)") || Boolean(network.connection?.saveData || network.mozConnection?.saveData || network.webkitConnection?.saveData);
document.querySelectorAll<HTMLVideoElement>(".js-bg-video").forEach((video) => {
  if (skip || !video.dataset.src) { video.autoplay = false; return; }
  video.addEventListener("playing", () => video.classList.add("is-playing"));
  video.addEventListener("error", () => video.classList.remove("is-playing"));
  const load = () => {
    if (video.dataset.loaded) return;
    const source = document.createElement("source");
    source.src = video.dataset.src!;
    source.type = "video/mp4";
    source.addEventListener("error", () => video.classList.remove("is-playing"));
    video.append(source);
    video.dataset.loaded = "true";
    video.load();
    void video.play().catch(() => video.classList.remove("is-playing"));
  };
  if ("requestIdleCallback" in window) window.requestIdleCallback(load, { timeout: 1200 }); else window.setTimeout(load, 500);
});
</script>
