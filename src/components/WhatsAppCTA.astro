---
import { buildDirectServiceUrl } from "../../assets/js/whatsapp.js";
interface Props { label: string; className?: string; ctaLocation: string; serviceName?: string; serviceSlug?: string; ctaText?: string; category?: string; intent?: string; ariaLabel?: string; direct?: boolean; }
const { label, className = "", ctaLocation, serviceName, serviceSlug, ctaText, category, intent, ariaLabel, direct = false } = Astro.props;
const directHref = direct ? buildDirectServiceUrl(serviceName) : null;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<a href={directHref || `${base}#formulario`} class={className} data-whatsapp-direct={directHref ? true : undefined} data-whatsapp-trigger={!directHref ? true : undefined} data-cta-location={ctaLocation} data-service-name={serviceName} data-service-slug={serviceSlug} data-cta-text={ctaText} data-category={category} data-intent={intent} aria-label={ariaLabel}>{label}</a>
