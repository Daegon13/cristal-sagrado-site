---
interface Props { label: string; className?: string; ctaLocation: string; serviceName?: string; ctaText?: string; category?: string; intent?: string; ariaLabel?: string; }
const { label, className = "", ctaLocation, serviceName, ctaText, category, intent, ariaLabel } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<a href={`${base}#formulario`} class={className} data-whatsapp-trigger data-cta-location={ctaLocation} data-service-name={serviceName} data-cta-text={ctaText} data-category={category} data-intent={intent} aria-label={ariaLabel}>{label}</a>
