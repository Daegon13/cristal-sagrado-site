---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { seoGuides } from "../../data/seo-guides.js";
import { canonical } from "../../lib/seo";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const schema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Inicio", item: canonical("/") },
  { "@type": "ListItem", position: 2, name: "Guías", item: canonical("/guias/") }
] };
---
<BaseLayout title="Guías de trabajos espirituales | Cristal Sagrado" description="Respuestas claras sobre los trabajos publicados en Cristal Sagrado y cómo consultar antes de elegir." path="/guias/" schema={schema}><main class="wrap seo-page"><nav aria-label="Ruta de navegación" class="seo-breadcrumbs"><ol><li><a href={base}>Inicio</a></li><li aria-current="page">Guías</li></ol></nav><header><span class="eyebrow">Orientación</span><h1>Guías para empezar</h1><p class="seo-lead">Preguntas frecuentes sobre los trabajos del catálogo. Leé lo que te sirva y, si necesitás orientación para tu caso, escribime.</p></header><ul class="seo-guide-list">{seoGuides.map((guide) => <li><h2><a href={`${base}guias/${guide.slug}/`}>{guide.title}</a></h2><p>{guide.answer}</p></li>)}</ul></main></BaseLayout>
