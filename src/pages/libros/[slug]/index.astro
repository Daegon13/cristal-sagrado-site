---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { books, type Book } from "../../../data/books";
import { bookInquiryUrl } from "../../../lib/book-contact";
import { SITE } from "../../../lib/constants";

export function getStaticPaths() { return books.map((book) => ({ params: { slug: book.slug }, props: { book } })); }
interface Props { book: Book; }
const { book } = Astro.props;
const path = `/libros/${book.slug}/`;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const available = book.status === "available";
const coverUrl = book.cover ? `${base}${book.cover.replace(/^\//, "")}` : undefined;
const sampleUrl = book.sampleUrl ? `${base}${book.sampleUrl.replace(/^\//, "")}` : undefined;
const schema = { "@context": "https://schema.org", "@graph": [
  { "@type": "Book", name: book.title, alternativeHeadline: book.subtitle, genre: book.primaryCategory, author: { "@type": "Person", name: book.author }, url: `${SITE.origin}${path}`, ...(book.cover ? { image: `${SITE.origin}/${book.cover.replace(/^\//, "")}` } : {}) },
  { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Inicio", item: SITE.origin }, { "@type": "ListItem", position: 2, name: "Libros", item: `${SITE.origin}/libros/` }, { "@type": "ListItem", position: 3, name: book.title, item: `${SITE.origin}${path}` }] }
] };
---
<BaseLayout title={`${book.title} | ${book.author} | Cristal Sagrado`} description={`${book.title}. ${book.shortSynopsis} ${available ? "Conocé la obra y sus opciones de distribución." : "Próximamente; leé una muestra gratuita."}`} path={path} schema={schema} ogImage={book.cover ? `/${book.cover.replace(/^\//, "")}` : undefined}>
  <main class="books-page" data-book-slug={book.slug}>
    <section class="section"><div class="wrap">
      <nav aria-label="Ruta de navegación"><a href={base}>Inicio</a> / <a href={`${base}libros/`}>Libros</a> / {book.title}</nav>
      <div class="book-detail">
        <div class:list={["book-cover", "book-cover--detail", { "book-cover--image": Boolean(book.cover) }]}>
          {coverUrl ? <img src={coverUrl} alt={`Portada de ${book.title}`} fetchpriority="high" /> : <span aria-hidden="true"><small>Portada pendiente</small><strong>{book.title}</strong><em>{book.author}</em></span>}
        </div>
        <div class="book-detail__intro">
          <span class="book-pill">{available ? "Disponible" : "PRÓXIMAMENTE"}</span>
          <span class="eyebrow">{book.primaryCategory}</span>
          <h1>{book.title}</h1>
          <p class="book-subtitle">{book.subtitle}</p>
          <p class="book-byline">Por {book.author}</p>
          {book.synopsis && <p class="book-synopsis">{book.synopsis}</p>}
          {book.topics.length > 0 && <ul class="book-topics" aria-label="Temas del libro">{book.topics.map((topic) => <li>{topic}</li>)}</ul>}
          <p class="book-status">{available ? `Disponible${book.formats.length ? ` en ${book.formats.join(", ").toUpperCase()}` : ""}.` : "Estamos preparando la publicación digital de este libro. Mientras tanto, podés conocer su contenido y leer una muestra gratuita."}{book.price && available && ` Precio: ${book.price}.`}</p>
          <div class="book-actions">
            {sampleUrl && <a class="button button--primary" href={sampleUrl} target="_blank" rel="noopener noreferrer" data-book-event="book_sample_download" data-book-slug={book.slug} data-cta-location="book_detail">Leer muestra gratuita</a>}
            {available && book.distribution === "free" && book.purchaseUrl && <a class="button button--primary" href={book.purchaseUrl} download>Descargar libro</a>}
            {available && book.distribution === "external" && book.purchaseUrl && <a class="button button--primary" href={book.purchaseUrl} data-book-event="book_purchase_click" data-book-slug={book.slug} data-cta-location="book_detail">Ir a compra</a>}
            {book.publicInquiry && <a class="text-link" href={bookInquiryUrl(book)} target="_blank" rel="noopener noreferrer" data-book-event="book_interest_wa" data-book-slug={book.slug} data-cta-location="book_detail">Consultar novedades por WhatsApp →</a>}
          </div>
          <p class="book-note">La muestra gratuita contiene cuatro páginas seleccionadas de una obra protegida por derechos de autor. Abrirla no confirma una lectura completa. La consulta por WhatsApp no realiza una compra ni una reserva.</p>
        </div>
      </div>
      {book.highlights && <section class="book-editorial-section" aria-labelledby="book-highlights"><span class="eyebrow">Dentro de la obra</span><h2 id="book-highlights">Qué vas a encontrar en este libro</h2><ul class="book-highlights">{book.highlights.map((item) => <li>{item}</li>)}</ul></section>}
      {book.contents && <section class="book-editorial-section" aria-labelledby="book-contents"><span class="eyebrow">Una mirada al recorrido</span><h2 id="book-contents">Selección del índice</h2><ol class="book-contents">{book.contents.map((item) => <li>{item}</li>)}</ol><p>Los títulos proceden del índice de la muestra. La selección no incluye paginación.</p></section>}
    </div></section>
  </main>
</BaseLayout>
