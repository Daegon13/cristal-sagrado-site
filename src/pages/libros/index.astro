---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCard from "../../components/BookCard.astro";
import { books } from "../../data/books";
import { SITE } from "../../lib/constants";
const schema = { "@context": "https://schema.org", "@type": "CollectionPage", name: "Libros de Lucía Mayada", url: `${SITE.origin}/libros/`, author: { "@type": "Person", name: "Lucía Mayada" } };
---
<BaseLayout title="Libros de Lucía Mayada | Cristal Sagrado" description="Conocé las obras de Lucía Mayada: portadas, sinopsis, índices y muestras gratuitas. Ediciones completas próximamente." path="/libros/" schema={schema}>
  <main class="books-page books-page--catalog"><section class="section"><div class="wrap">
    <div class="book-catalog-hero">
      <div class="book-catalog-hero__copy">
        <nav aria-label="Ruta de navegación"><a href={import.meta.env.BASE_URL}>Inicio</a> / Libros</nav>
        <div class="section-intro book-catalog-intro"><span class="eyebrow">Biblioteca editorial</span><h1>Libros de Lucía Mayada</h1><p>Historias, prácticas y reflexiones para explorar la magia, el símbolo y las posibilidades de transformación personal.</p><p>Conocé las tres obras, recorré sus índices y leé una muestra gratuita. Las ediciones completas estarán disponibles próximamente.</p></div>
      </div>
      <div class="book-catalog-hero__art" aria-hidden="true"><span class="book-catalog-hero__moon"></span><span class="book-catalog-hero__orbit"></span><span class="book-catalog-hero__diamond"></span></div>
    </div>
    <div class="book-grid">{books.map((book) => <BookCard book={book} />)}</div>
  </div></section></main>
</BaseLayout>
