---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCard from "../../components/BookCard.astro";
import { books } from "../../data/books";
import { SITE } from "../../lib/constants";
const schema = { "@context": "https://schema.org", "@type": "CollectionPage", name: "Libros de Lucía Mayada", url: `${SITE.origin}/libros/`, author: { "@type": "Person", name: "Lucía Mayada" } };
---
<BaseLayout title="Libros de Lucía Mayada | Cristal Sagrado" description="Conocé las obras de Lucía Mayada en Cristal Sagrado. Próximamente, vistas previas y opciones para conseguir cada libro." path="/libros/" schema={schema}>
  <main class="books-page"><section class="section"><div class="wrap"><nav aria-label="Ruta de navegación"><a href={import.meta.env.BASE_URL}>Inicio</a> / Libros</nav><div class="section-intro"><span class="eyebrow">Biblioteca editorial</span><h1>Libros de Lucía Mayada</h1><p>Conocé los tres títulos en preparación. Las vistas previas y las opciones para conseguirlos aparecerán cuando estén listas.</p></div><div class="book-grid">{books.map((book) => <BookCard book={book} />)}</div></div></section></main>
</BaseLayout>
