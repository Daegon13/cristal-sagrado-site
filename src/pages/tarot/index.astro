---
import BaseLayout from "../../layouts/BaseLayout.astro"; import Hero from "../../components/Hero.astro"; import FinalCTA from "../../components/FinalCTA.astro"; import { pageMetadata } from "../../lib/seo";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout {...pageMetadata.tarot} path="/tarot/"><main><Hero title="Lecturas de Tarot" subtitle="Traé tus preguntas y exploramos lo que muestran las cartas. Podés contarme tu situación antes de elegir una lectura." action="Consultar por WhatsApp" href={`${base}#formulario`} ctaLocation="tarot" /><section class="section"><div class="wrap"><h2>Tipos de lectura</h2><div class="service-grid"><article class="service-card"><h3>Lectura General</h3><p>Una mirada a los temas que hoy te ocupan.</p></article><article class="service-card"><h3>Amor y Relaciones</h3><p>Para conversar sobre tus vínculos y preguntas afectivas.</p></article><article class="service-card"><h3>Trabajo y Finanzas</h3><p>Para explorar decisiones laborales y económicas.</p></article><article class="service-card"><h3>Lectura Express</h3><p>Para enfocar una pregunta puntual.</p></article></div></div></section><FinalCTA /></main></BaseLayout>
