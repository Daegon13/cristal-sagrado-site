---
import BaseLayout from "../../layouts/BaseLayout.astro"; import Hero from "../../components/Hero.astro"; import FinalCTA from "../../components/FinalCTA.astro"; import { pageMetadata } from "../../lib/seo";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout {...pageMetadata.tarot} path="/tarot/"><main><Hero title="Lecturas de Tarot" subtitle="Conecta con tu destino a través de las cartas." action="Solicita tu lectura" href={`${base}#formulario`} /><section class="section"><div class="wrap"><h2>Tipos de Lectura</h2><div class="service-grid"><article class="surface service-card"><h3>Lectura General</h3><p>Un vistazo completo a tu situación actual.</p></article><article class="surface service-card"><h3>Amor y Relaciones</h3><p>Explora el estado y futuro de tus vínculos afectivos.</p></article><article class="surface service-card"><h3>Trabajo y Finanzas</h3><p>Recibe orientación en tu camino profesional y económico.</p></article><article class="surface service-card"><h3>Lectura Express</h3><p>Resuelve una duda puntual en pocos minutos.</p></article></div></div></section><FinalCTA /></main></BaseLayout>
